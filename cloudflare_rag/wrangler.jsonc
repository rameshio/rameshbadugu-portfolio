{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rameshbadugu-portfolio-rag",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-20",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  },
  "vars": {
    "ENVIRONMENT": "production",
    "EMBEDDING_MODEL": "@cf/baai/bge-small-en-v1.5",
    "OPENROUTER_MODEL": "google/gemma-4-26b-a4b-it:free",
    "OPENROUTER_FALLBACK_MODELS": "nvidia/nemotron-3.5-lightning:free,openrouter/free",
    "OPENROUTER_SITE_URL": "https://rameshbaduguai.com",
    "OPENROUTER_APP_NAME": "Ramesh Badugu Portfolio RAG",
    "RETRIEVAL_TOP_K": "4",
    "RATE_LIMIT_MAX_REQUESTS": "30",
    "RATE_LIMIT_WINDOW_SECONDS": "900",
    "REQUIRE_AUTH": "true",
    "ALLOWED_ORIGINS": ""
  },
  "ai": {
    "binding": "AI"
  },
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "portfolio-rag-index"
    }
  ],
  "ratelimits": [
    {
      "name": "CHAT_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ]
  // Optional R2 bucket binding for storing raw resume/project documents.
  // Uncomment after creating the R2 bucket and approving deployment:
  // "r2_buckets": [
  //   {
  //     "binding": "DOCS_BUCKET",
  //     "bucket_name": "portfolio-rag-docs"
  //   }
  // ]
  // Required secrets (set via `wrangler secret put` — NEVER put in vars):
  // - OPENROUTER_API_KEY
  // - RAG_API_KEY
}
