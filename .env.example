EMAILJS_SERVICE_ID=your_service_id_here
EMAILJS_TEMPLATE_ID=your_template_id_here
EMAILJS_PUBLIC_KEY=your_public_key_here
# Recommended when your EmailJS account supports private API authentication.
EMAILJS_PRIVATE_KEY=your_private_key_here

# For local UI testing only. Never enable this in production.
# CONTACT_DELIVERY_MODE=console

# Portfolio AI Assistant (priority order: RAG_API_URL -> GEMINI_API_KEY -> OPENAI_API_KEY -> built-in Q&A)
# Connect your Python LangChain RAG service endpoint here:
# RAG_API_URL=http://127.0.0.1:8000/chat
# Shared secret required by the Python FastAPI /chat endpoint (Authorization: Bearer <RAG_API_KEY>)
# RAG_API_KEY=replace_with_a_long_random_secret

# Python FastAPI RAG Backend (OpenRouter + ChromaDB)
# OPENROUTER_API_KEY=your_openrouter_api_key_here
# OPENROUTER_MODEL=openai/gpt-4o-mini
# RAG_ENV=development
# RAG_REQUIRE_AUTH=true
# RAG_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8787

# Or use Gemini / OpenAI directly with grounded portfolio context:
# GEMINI_API_KEY=your_gemini_api_key
# GEMINI_MODEL=gemini-2.5-flash
# OPENAI_API_KEY=your_openai_api_key
# OPENAI_MODEL=gpt-4o-mini

# Persistent distributed rate limiting for Vercel /api/chat and /api/contact (Upstash Redis)
# UPSTASH_REDIS_REST_URL=https://your-upstash-endpoint.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token
